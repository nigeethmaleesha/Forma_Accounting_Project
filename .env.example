# COPY TO .env ON THE PHP SERVER. NEVER COMMIT OR SHARE .env.
SITE_URL=https://www.trendytaxsolutions.com.au
DB_HOST=localhost
DB_NAME=your_mysql_database
DB_USER=your_mysql_user
DB_PASSWORD=YOUR_DATABASE_PASSWORD
# CRITICAL: Outside public_html/document root, owned by PHP user (chmod 700).
PRIVATE_STORAGE_PATH=/home/YOUR_CPANEL_USER/tts-private-documents
# MAIL_FROM should be a mailbox with SPF/DKIM correctly configured.
MAIL_FROM=info@trendytaxsolutions.com.au
# Optional but highly recommended: configure Cloudflare Turnstile for public forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
